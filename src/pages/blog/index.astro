---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { site } from '../../lib/site';

const posts = await getPosts();
const jsonLd = [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }])];
const title = "Tips & Guides | Tropical Bay Builders";
const description = "Practical remodeling, construction and storm-restoration advice for Southwest Florida homeowners from Tropical Bay Builders.";
---

<Base title={title} description={description} jsonLd={jsonLd}>
<div class="page-header">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / Blog</p>
    <h1>Tips &amp; Guides from <em>Tropical Bay Builders</em></h1>
    <p>Straightforward advice on hiring contractors, planning a remodel, and building for Florida's climate - from a crew that does this work every day in North Port and Southwest Florida.</p>
  </div>
</div>
  <section>
    <div class="container">
      <div class="grid-2">
      {posts.length === 0 && <p>New articles are coming soon.</p>}
      {posts.map((p) => (
        <div class="card">
          {p.data.category && <span class="eyebrow-dark" style="margin-bottom:16px;">{p.data.category}</span>}
          <h3 style="font-size:1.4rem;">{p.data.title}</h3>
          <p>{p.data.description}</p>
          <div style="display:flex; gap:14px; margin-top:16px; font-size:0.82rem; color:var(--text-muted-dk);"><span>{formatDate(p.data.date)}</span><span>·</span><span>{readingTime(p.body ?? '')}</span></div>
          <a href={`/blog/${p.id}`} class="card-link">Read Article →</a>
        </div>
      ))}
      </div>
    </div>
  </section>

</Base>
